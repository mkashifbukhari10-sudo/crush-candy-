// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum ApprovalSource {
  ACCESS_CODE
  ADMIN_MANUAL
  MIGRATION
}

enum AccessCodeStatus {
  ACTIVE
  CLAIMED
  REDEEMED
  REVOKED
}

model CustomerProfile {
  id                       String          @id @default(cuid())
  shopifyCustomerId        String          @unique
  approvedAt               DateTime?
  approvalSource           ApprovalSource?
  accessCodeUsedId         String?         @unique
  approvalRevokedAt        DateTime?
  lastShopifyTagObservedAt DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  accessCodeUsed AccessCode? @relation("CustomerApprovalCode", fields: [accessCodeUsedId], references: [id], onDelete: SetNull)

  @@index([approvedAt])
}

model AccessCode {
  id                   String           @id @default(cuid())
  codeHash             String           @unique
  codeLast4            String
  createdByAdminId     String
  expiresAt            DateTime
  status               AccessCodeStatus @default(ACTIVE)
  claimedAt            DateTime?
  claimedByCustomerId  String?
  redeemedAt           DateTime?
  redeemedByCustomerId String?
  revokedAt            DateTime?
  revokedBy            String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  approvedCustomer CustomerProfile? @relation("CustomerApprovalCode")

  @@index([status, expiresAt])
  @@index([redeemedByCustomerId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorPlane String
  actorId    String
  action     String
  targetType String
  targetId   String
  payload    Json
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([actorPlane, actorId, createdAt])
  @@index([action, createdAt])
}

model RateLimitBucket {
  keyHash   String   @id
  count     Int
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

enum DriverStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model DriverAccount {
  id                  String       @id @default(cuid())
  email               String       @unique
  passwordHash        String?
  status              DriverStatus @default(INVITED)
  activationTokenHash String?      @unique
  activationExpiresAt DateTime?
  resetTokenHash      String?      @unique
  resetExpiresAt      DateTime?
  passwordChangedAt   DateTime?
  failedLoginCount    Int          @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  createdByAdminId    String
  deactivatedAt       DateTime?
  deactivatedBy       String?
  deactivationReason  String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  driver   Driver?
  sessions DriverSession[]
  events   DriverAuthEvent[]

  @@index([status])
  @@index([lockedUntil])
}

model Driver {
  id          String        @id @default(cuid())
  accountId   String        @unique
  account     DriverAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  displayName String
  phone       String?
  vehicleNote String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  assignments Assignment[]

  @@index([displayName])
}

enum AssignmentStatus {
  PENDING
  ASSIGNED
  SCHEDULED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

model Assignment {
  id                 String           @id @default(cuid())
  shopifyOrderId     String           @unique
  shopifyOrderNumber String
  shopifyCustomerId  String?
  status             AssignmentStatus @default(PENDING)
  slaDueAt           DateTime
  scheduledFor       DateTime?
  assignedAt         DateTime?
  assignedBy         String?
  dispatchedAt       DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  lineItems          Json?
  destinationCity    String?
  destinationPostcode String?
  driverId           String?
  driver             Driver?          @relation(fields: [driverId], references: [id], onDelete: SetNull)
  conversation       Conversation?
  events             AssignmentEvent[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([driverId, scheduledFor])
  @@index([status, slaDueAt])
  @@index([shopifyCustomerId, createdAt])
}

model AssignmentEvent {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  type         String
  actorPlane   String
  actorId      String
  metadata     Json
  createdAt    DateTime   @default(now())

  @@index([assignmentId, createdAt])
}

model AppSettings {
  id                 String   @id @default("singleton")
  autoAssignEnabled  Boolean  @default(false)
  autoAssignDriverId String?
  processingWindowHours Int @default(24)
  minDeliverySpendCents Int @default(25000)
  deliveryEnabled Boolean @default(true)
  distanceMethod DistanceMethod?
  kmRoundingMode KmRounding?
  baseLatitude Decimal?
  baseLongitude Decimal?
  tierUnder25Cents Int @default(5000)
  tier25To40Cents Int @default(7500)
  tier40To55Cents Int @default(12000)
  over55BaseCents Int @default(12000)
  over55PerKmCents Int @default(300)
  updatedAt          DateTime @updatedAt
}

enum DistanceMethod {
  STRAIGHT_LINE
  DRIVING
}
enum KmRounding {
  EXACT
  CEIL
  FLOOR
  NEAREST
}

enum ConversationKind {
  ORDER_DELIVERY
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum ParticipantRole {
  CUSTOMER
  DRIVER
}

model Conversation {
  id                    String             @id @default(cuid())
  kind                  ConversationKind   @default(ORDER_DELIVERY)
  status                ConversationStatus @default(OPEN)
  assignmentId          String             @unique
  assignment            Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  shopifyOrderId        String             @unique
  shopifyCustomerId     String
  closedAt              DateTime?
  visibleToCustomerUntil DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  messages              Message[]
  participants          ConversationParticipant[]

  @@index([shopifyCustomerId, createdAt])
  @@index([status, updatedAt])
}

model ConversationParticipant {
  id                String           @id @default(cuid())
  conversationId    String
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  role              ParticipantRole
  subjectId         String
  joinedAt          DateTime         @default(now())
  leftAt            DateTime?
  lastReadAt        DateTime?
  lastReadMessageId String?

  @@unique([conversationId, role, subjectId])
  @@index([subjectId, leftAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  senderType     ParticipantRole
  senderId       String
  senderLabel    String
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt, id])
}

model DriverSession {
  id                String        @id @default(cuid())
  accountId         String
  account           DriverAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash         String        @unique
  issuedAt          DateTime      @default(now())
  lastSeenAt        DateTime      @default(now())
  absoluteExpiresAt DateTime
  idleExpiresAt     DateTime
  revokedAt         DateTime?
  revokedReason     String?
  ip                String?
  userAgent         String?

  @@index([accountId, revokedAt])
  @@index([absoluteExpiresAt])
  @@index([idleExpiresAt])
}

model DriverAuthEvent {
  id         String         @id @default(cuid())
  accountId  String?
  account    DriverAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  type       String
  emailTried String?
  ip         String?
  userAgent  String?
  createdAt  DateTime       @default(now())

  @@index([accountId, createdAt])
  @@index([type, createdAt])
}
