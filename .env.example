# Required database configuration (PostgreSQL only)
DATABASE_URL=

# Required Shopify app runtime configuration
SHOPIFY_API_KEY="<shopify-client-id>"
SHOPIFY_API_SECRET="<shopify-api-secret>"
SHOPIFY_APP_URL="https://<app-host>"
SCOPES="write_customers,write_app_proxy"

# Single-store configuration. SHOP_CUSTOM_DOMAIN is supported by the
# official Shopify adapter; SHOPIFY_STORE_DOMAIN is the expected canonical shop.
SHOPIFY_STORE_DOMAIN=""
SHOP_CUSTOM_DOMAIN=""

# Recommended M1 key-separation overrides (at least 32 random characters each).
# If omitted, domain-separated keys are securely derived from SHOPIFY_API_SECRET.
ACCESS_CODE_HASH_SECRET="<generate-a-random-secret>"
CUSTOMER_CSRF_SECRET="<generate-a-random-secret>"

# Future driver form protection (DEFERRED TO M2)
DRIVER_CSRF_SECRET=""

# Future driver auth settings (DEFERRED TO M2)
DRIVER_SESSION_COOKIE_NAME="__Host-ccs_driver"
DRIVER_IDLE_TIMEOUT_MINUTES="120"
DRIVER_ABSOLUTE_TIMEOUT_HOURS="12"

# Future transactional email provider (DEFERRED TO M4)
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM=""

# Future distance provider (DEFERRED TO M6)
DISTANCE_PROVIDER=""
DISTANCE_API_KEY=""

# Future S3-compatible object storage (DEFERRED TO M4)
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_REGION=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
